    {
      "id": "graph-vc",
      "concept": "Vertex cover",
      "type": "graph",
      "objective": "Let the learner solve vertex cover by tapping nodes",
      "hook": "Choose the smallest set of nodes that touches every edge.",
      "statement": "Tap nodes. A selected node covers every edge it touches. Get it as small as you can.",
      "visual": {
        "kind": "graphVisual",
        "config": {
          "mode": "vertexCover",
          "nodes": [
            { "id": "A", "label": "A", "x": 30, "y": 25 },
            { "id": "B", "label": "B", "x": 70, "y": 25 },
            { "id": "C", "label": "C", "x": 30, "y": 75 },
            { "id": "D", "label": "D", "x": 70, "y": 75 }
          ],
          "edges": [
            { "source": "A", "target": "B" },
            { "source": "A", "target": "C" },
            { "source": "A", "target": "D" },
            { "source": "B", "target": "D" },
            { "source": "C", "target": "D" }
          ],
          "minimalSize": 2
        }
      },
      "difficulty": 2,
      "prerequisites": ["graph-intro", "vertex-cover"],
      "next": ["graph-vc-quiz"],
      "attentionPattern": "direct manipulation",
      "rhythm": "high"
    },
    {
      "id": "graph-vc-quiz",
      "concept": "Vertex cover",
      "type": "quiz",
      "objective": "Check the rule that defines a vertex cover",
      "hook": "Check the rule",
      "interaction": {
        "kind": "quiz",
        "prompt": "In a vertex cover, every edge must be touched by...",
        "options": [
          {
            "label": "at least one selected node",
            "correct": true,
            "explanation": "One node can cover many edges at once — that is the whole point."
          },
          {
            "label": "exactly one selected node",
            "correct": false,
            "explanation": "An edge between two selected nodes would then break the rule."
          },
          {
            "label": "every node in the graph",
            "correct": false,
            "explanation": "Selecting everything covers all edges — but it is never minimal."
          }
        ]
      },
      "reveal": "Each edge needs at least one endpoint in the set. Fewer is better.",
      "difficulty": 2,
      "prerequisites": ["graph-vc"],
      "next": ["graph-vc-reveal"],
      "attentionPattern": "rule check",
      "rhythm": "medium"
    },
    {
      "id": "graph-vc-reveal",
      "concept": "Vertex cover",
      "type": "concept",
      "objective": "Name the concept after the visual experience",
      "hook": "This is Vertex Cover.",
      "statement": "The smallest set of nodes that touches every edge.",
      "facts": [
        "Every edge has at least one endpoint in the cover.",
        "Covering is easy.",
        "Finding the smallest cover gets hard fast."
      ],
      "difficulty": 2,
      "prerequisites": ["graph-vc-quiz", "vertex-cover"],
      "next": ["graph-vc-scale"],
      "attentionPattern": "name the thing",
      "rhythm": "low"
    },
    {
      "id": "graph-vc-scale",
      "concept": "Vertex cover",
      "type": "graph",
      "objective": "Show that bigger graphs make minimality harder",
      "hook": "Now find the minimum.",
      "statement": "Cover all eight edges with the fewest nodes. The minimum is three — can you find it?",
      "visual": {
        "kind": "graphVisual",
        "config": {
          "mode": "vertexCover",
          "nodes": [
            { "id": "A", "label": "A", "x": 15, "y": 30 },
