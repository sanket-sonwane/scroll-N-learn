            { "source": "D", "target": "E" },
            { "source": "D", "target": "F" },
            { "source": "E", "target": "F" }
          ],
          "minimalSize": 3
        }
      },
      "difficulty": 3,
      "prerequisites": ["graph-vc-reveal"],
      "next": ["graph-ham-intro"],
      "attentionPattern": "escalating challenge",
      "rhythm": "high"
