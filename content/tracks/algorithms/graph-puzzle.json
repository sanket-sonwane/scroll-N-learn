    {
      "id": "graph-ham-quiz",
      "concept": "Hamiltonian cycle",
      "type": "quiz",
      "objective": "Name the concept after solving it",
      "hook": "Name the thing",
      "interaction": {
        "kind": "quiz",
        "prompt": "A route that visits every vertex exactly once and returns to the start is called...",
        "options": [
          { "label": "A cycle", "correct": true, "explanation": "Every vertex once, closed back to the start — that is a Hamiltonian cycle." },
          { "label": "A path", "correct": false, "explanation": "A path visits each vertex once but does not close the loop." },
          { "label": "A tree", "correct": false, "explanation": "A tree has no cycles at all." },
          { "label": "A vertex cover", "correct": false, "explanation": "A vertex cover is about touching edges with nodes, not routes." }
        ]
      },
      "reveal": "Visit every vertex once, close the loop — that is a Hamiltonian cycle.",
      "difficulty": 2,
      "prerequisites": ["graph-ham-invalid"],
      "next": ["graph-ham-reveal"],
      "attentionPattern": "recall check",
      "rhythm": "medium"
    },
    {
      "id": "graph-ham-reveal",
      "concept": "Hamiltonian cycle",
      "type": "concept",
      "objective": "Formalize the Hamiltonian cycle concept",
      "hook": "This is a Hamiltonian Cycle.",
      "statement": "One continuous route that visits every vertex exactly once and returns to the start.",
      "facts": [
        "Checking a proposed route is quick.",
        "Finding one from scratch is the hard part.",
        "Add a few more vertices and the search explodes."
