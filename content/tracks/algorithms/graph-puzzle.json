      "id": "graph-intro",
      "concept": "Graph",
      "type": "visual",
      "objective": "Introduce graphs as nodes and edges",
      "hook": "A graph: things, and connections between them.",
      "statement": "Nodes are objects. Edges are relationships. That is the whole model.",
      "visual": {
        "kind": "graphVisual",
        "config": {
          "mode": "show",
          "nodes": [
            { "id": "A", "label": "A", "x": 30, "y": 25 },
