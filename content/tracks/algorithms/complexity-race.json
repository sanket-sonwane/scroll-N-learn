    {
      "id": "complexity-rank",
      "concept": "Growth rate",
      "type": "comparison",
      "objective": "Test the ability to order growth classes",
      "hook": "Slower to faster.",
      "statement": "Order the growth classes — from the slowest to the fastest.",
      "interaction": {
        "kind": "rank",
        "prompt": "Drag each class into increasing growth order.",
        "items": [
          { "id": "logn", "label": "O(log n)" },
          { "id": "linear", "label": "O(n)" },
          { "id": "nlogn", "label": "O(n log n)" },
          { "id": "quadratic", "label": "O(n²)" },
          { "id": "exponential", "label": "O(2ⁿ)" },
          { "id": "factorial", "label": "O(n!)" }
        ],
        "correctOrder": ["logn", "linear", "nlogn", "quadratic", "exponential", "factorial"]
      },
      "difficulty": 3,
      "prerequisites": ["complexity-universe", "growth-rate"],
      "next": ["complexity-billion"],
      "attentionPattern": "interactive reorder",
      "rhythm": "high"
    },
    {
      "id": "complexity-billion",
      "concept": "Linear time",
      "type": "prediction",
      "objective": "Connect growth classes to real dataset sizes",
      "hook": "Practical check",
      "interaction": {
        "kind": "predict",
        "prompt": "Which one would you choose for a billion-item dataset?",
        "options": [
          {
            "label": "O(n²)",
            "correct": false,
            "explanation": "At n = 10⁹ that is ≈ 10¹⁸ comparisons — decades on a billion ops per second."
          },
          {
            "label": "O(n log n)",
            "correct": true,
            "explanation": "≈ 30 billion steps — seconds, not years. This scales."
          },
          {
            "label": "O(2ⁿ)",
            "correct": false,
            "explanation": "2ⁿ already hits a billion at n = 30. At n = 10⁹ it is physically impossible."
          },
          {
            "label": "O(n!)",
            "correct": false,
            "explanation": "n! grows faster than exponential — unusable for any large input."
          }
        ]
      },
      "reveal": "For a billion items, anything quadratic or worse is effectively unusable. That is what growth rate decides.",
      "difficulty": 3,
      "prerequisites": ["complexity-rank"],
      "next": ["complexity-compress"],
      "attentionPattern": "predict then payoff",
      "rhythm": "high"
    },
    {
      "id": "complexity-compress",
      "concept": "Growth rate",
      "type": "concept",
      "objective": "Compress the experience into one definition",
